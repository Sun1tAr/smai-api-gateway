{
  "openapi": "3.1.0",
  "info": {
    "title": "smai-api-dictionary (контракт MS-2, снимок)",
    "version": "v2",
    "description": "Снимок контракта API-7 (SMAI-A-194), собран из OpenAPI MS-2 (SMAI-86). Заменяется экспортом OpenAPI из MS-2. $ref в снимках контрактов не допускается."
  },
  "paths": {
    "/dictionaries": {
      "get": {
        "summary": "Получение справочников (API-7)",
        "description": "Возвращает одним ответом четыре фиксированных справочника для экранов параметров: пищевые привычки (`habits`), диеты (`diets`), аллергены (`allergies`) и кухонную технику (`kitchenTools`). Каждый элемент — `{id, name}`; `id` стабилен, элементы упорядочены по `id`. Параметров нет, лишние query-параметры игнорируются. Данные читаются одним согласованным снимком БД.",
        "responses": {
          "200": {
            "description": "Справочники получены.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "habits": {
                      "items": {
                        "properties": {
                          "id": {
                            "type": "integer",
                            "title": "Id",
                            "description": "Стабильный идентификатор значения, уникальный внутри справочника.",
                            "examples": [
                              1
                            ]
                          },
                          "name": {
                            "type": "string",
                            "title": "Name",
                            "description": "Название значения, уникальное внутри справочника.",
                            "examples": [
                              "Быстрые перекусы"
                            ]
                          }
                        },
