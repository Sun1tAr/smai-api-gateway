# Адрес MS-4 внутри Docker-сети контура (обязательно, без пути).
UPSTREAM_RECIPES_URL=http://recipes:8000
# Адрес MS-2 (справочники) внутри Docker-сети контура (обязательно, без пути).
UPSTREAM_DICTIONARY_URL=http://dictionary:8000
# Адрес MS-3 (пользователи) внутри Docker-сети контура (обязательно, без пути).
UPSTREAM_USER_URL=http://user:8000
# Только локальный Compose: путь на хосте к PEM-файлу приватного ключа JWT (ES256, P-256,
# без пароля). Создать: openssl ecparam -name prime256v1 -genkey -noout -out jwt-private.pem
# В контейнере файл лежит по JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key (обязательно).
JWT_PRIVATE_KEY_PATH=./jwt-private.pem

# Redis с отозванными токенами (обязательно): redis://[:password@]host:port/db.
# Пароль только через URL из секрета. В контуре Redis доступен только из сети smai,
# с appendonly yes, appendfsync everysec и maxmemory-policy noeviction.
REDIS_URL=redis://redis:6379/0

# Порт на хосте для локального запуска (kiosk занимает 8000, MS-4 — 8001).
GATEWAY_HTTP_PORT=8080

# Необязательные настройки (значения по умолчанию показаны).
# UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
# UPSTREAM_READ_TIMEOUT_SECONDS=10
# UPSTREAM_WRITE_TIMEOUT_SECONDS=5
# UPSTREAM_POOL_TIMEOUT_SECONDS=2
# UPSTREAM_TOTAL_TIMEOUT_SECONDS=12
# Общий таймаут и ожидание данных только для POST /recipes/cart, секунды (0 < x <= 120).
# UPSTREAM_CART_TIMEOUT_SECONDS=40
# Общий таймаут и ожидание данных только для API-18 (0 < x <= 180, секунды).
# Значение должно быть больше REPLACE_WAIT_SECONDS в MS-4.
# UPSTREAM_REPLACE_TIMEOUT_SECONDS=125
# UPSTREAM_MAX_CONNECTIONS=100
# UPSTREAM_KEEPALIVE_EXPIRY_SECONDS=2
# UPSTREAM_MAX_RESPONSE_BYTES=2097152
# MAX_REQUEST_BODY_BYTES=65536
# ROUTES_FILE=config/routes.toml
# CONTRACT_FILE=contracts/receipes.openapi.json
# CONTRACT_DICTIONARY_FILE=contracts/dictionary.openapi.json
# CONTRACT_USER_FILE=contracts/user.openapi.json
# REDIS_CONNECT_TIMEOUT_SECONDS=1
# REDIS_OPERATION_TIMEOUT_SECONDS=1
# Срок жизни JWT, секунд (60..2592000).
# JWT_TTL_SECONDS=86400
LOG_LEVEL=INFO
# Пусто = трейсы не экспортируются.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Общие лимиты для POST /recipes/generate-menu и POST /recipes/generate-menu/{task_id}/replace-recipe.
# Включённому лимиту нужен режим ключа: TRUSTED_PROXIES (точные адреса прокси через
# запятую) либо RATE_LIMIT_KEY_BY_SOCKET=true (локально; за прокси так делать нельзя).
# RATE_LIMIT_KEY_BY_SOCKET=true  # ТОЛЬКО локально, см. README «Локальный запуск»
# TRUSTED_PROXIES=
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_GLOBAL_REQUESTS=100
# RATE_LIMIT_IPV6_PREFIX=56
# RATE_LIMIT_MAX_KEYS=10000

# Лимит на POST /auth/register и POST /auth/login: свой бакет на клиента (общий для обоих
# маршрутов) и свой общий потолок, отдельно от лимита выше. Окно то же
# (RATE_LIMIT_WINDOW_SECONDS); включается только вместе с RATE_LIMIT_ENABLED=true.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_GLOBAL_REQUESTS=60

# POST /recipes/cart: отдельные лимиты клиента и процесса gateway за то же окно.
# Работают при RATE_LIMIT_ENABLED=true. Счётчики не общие с другими маршрутами.
# CART_RATE_LIMIT_ENABLED=true
# CART_RATE_LIMIT_REQUESTS=1
# CART_RATE_LIMIT_GLOBAL_REQUESTS=3
